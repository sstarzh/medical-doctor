# --- Model providers ------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# MEDICAL_DOCTOR_PROVIDER=anthropic       # anthropic | openai | meta
# OPENAI_API_KEY=sk-...                    # OpenAI (default model gpt-6-sol)
# LLAMA_API_KEY=...                        # Meta Llama API (default Llama-4-Maverick-17B-128E-Instruct-FP8)
# MEDICAL_DOCTOR_LLAMA_BASE_URL=https://api.together.xyz/v1   # any OpenAI-compatible Llama host
# MEDICAL_DOCTOR_LLAMA_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
# MEDICAL_DOCTOR_SECOND_OPINION=anthropic,openai,meta         # multi-model panel for consult(second_opinion=true)

# --- Patient records (personal doctor) -------------------------------------
# Generate with: medical-doctor-mcp gen-data-key k1   (keep it in your secret manager; losing it loses the records)
# MEDICAL_DOCTOR_DATA_KEYS=k1:...
# MEDICAL_DOCTOR_EFFORT=high            # use "medium" if chat clients time out on long consults

# --- Public endpoint -----------------------------------------------------
MEDICAL_DOCTOR_PUBLIC_URL=https://doctor.example.com   # clients connect to $PUBLIC_URL/mcp

# --- Authentication: none | apikey | oauth | jwt -------------------------
MEDICAL_DOCTOR_AUTH=oauth

# Who may sign in (required for oauth unless MEDICAL_DOCTOR_ALLOW_ANY_USER=1)
MEDICAL_DOCTOR_ALLOWED_DOMAINS=example.com
# MEDICAL_DOCTOR_ALLOWED_EMAILS=alice@gmail.com,bob@outlook.com

# Sign-in providers (enable any combination). Redirect URI to register with each:
#   $MEDICAL_DOCTOR_PUBLIC_URL/oauth/callback/<google|github|microsoft|oidc>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=<your tenant GUID>
# OIDC_ISSUER=https://your-idp.example.com     # Okta, Auth0, Keycloak, Axiad, Ping, ...
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Company SSO

# API keys for headless agents/automation (work alongside OAuth). Generate: medical-doctor-mcp gen-key <label>
# MEDICAL_DOCTOR_API_KEYS=ci-bot:mdk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# External authorization server instead of the built-in one (MEDICAL_DOCTOR_AUTH=jwt)
# MEDICAL_DOCTOR_JWT_ISSUER=https://your-tenant.auth0.com
# MEDICAL_DOCTOR_JWT_AUDIENCE=https://doctor.example.com/mcp

# MEDICAL_DOCTOR_JWT_TRUST_UNVERIFIED_EMAIL=1  # only if users can't edit the email claim at your IdP

# --- Sessions ------------------------------------------------------------
# MEDICAL_DOCTOR_MAX_SESSION_DAYS=90    # absolute sign-in lifetime; refresh rotation can't extend it

# --- Limits / ops -------------------------------------------------------
# FORWARDED_ALLOW_IPS=10.0.0.0/8       # trust X-Forwarded-* only from your load balancer (default 127.0.0.1)
# MEDICAL_DOCTOR_CONSULT_LIMIT_PER_HOUR=30
# MEDICAL_DOCTOR_DB=/data/auth.db
# POSTGRES_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres   # Supabase (serverless / multi-instance)
# MEDICAL_DOCTOR_STATELESS=1           # behind a load balancer without sticky sessions
